# Copy to `.env` at the repository root and fill in secrets. Never commit `.env`.
# Backend, ingestion scripts and tests read this file via backend/app/settings.py (process env overrides it).

OPENAI_API_KEY=
VOYAGE_API_KEY=
APIFY_API_TOKEN=

OPENAI_MODEL=gpt-6-luna
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_DIMENSION=512
DATABASE_PATH=./data/cafe.db

ENABLE_APIFY_LIVE_SEARCH=false
ENABLE_AGENT_TRACING=true

# Staff PIN for the admin dashboard (>= 6 characters). Admin login is disabled (HTTP 503) while empty.
ADMIN_PIN=
# OpenAI Agents SDK SQLiteSession store, kept in its own file to avoid write-lock contention with orders.
AGENT_SESSIONS_DB_PATH=./data/agent_sessions.db
# Vite dev server origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173
